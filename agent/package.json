{
  "name": "editmax-agent",
  "version": "0.1.0",
  "private": true,
  "description": "EditMax's API-key chat backend: the Claude Agent SDK, or Claude / OpenAI / Google / xAI through the Vercel AI SDK, over NDJSON on stdin/stdout.",
  "type": "module",
  "scripts": {
    "build": "bun build --compile --minify --target=bun-darwin-arm64 src/main.ts --outfile dist/editmax-agent && codesign --force --sign - dist/editmax-agent",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.97",
    "@ai-sdk/google": "4.0.112",
    "@ai-sdk/mcp": "2.0.91",
    "@ai-sdk/openai": "4.0.109",
    "@ai-sdk/xai": "5.0.39",
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "ai": "7.0.163"
  },
  "devDependencies": {
    "@types/bun": "1.3.3",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk-linux-x64": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "npm:empty-npm-package@1.0.0",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "npm:empty-npm-package@1.0.0"
  }
}
