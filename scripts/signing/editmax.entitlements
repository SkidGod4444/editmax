<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- EditMax.app itself, signed with the hardened runtime by scripts/package.sh.
     audio-input: the chat's microphone (Dictation.swift). Without it the hardened runtime hands the app silence and
     macOS never asks for permission. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
